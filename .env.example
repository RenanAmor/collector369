# Collector369 - Variáveis de Ambiente

APP_ENV=local
APP_DEBUG=true

# Storage
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=daily

# Providers
INVESTING_BASE_URL=
INVESTING_CARTEIRA_URL=
INVESTING_EXPORT_SELECTOR=text=Exportar
TRADINGVIEW_BASE_URL=
YAHOO_FINANCE_BASE_URL=
BANCO_CENTRAL_BASE_URL=
B3_BASE_URL=

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=60000

# Perfil persistente do Chrome real (mantém a sessão logada entre execuções)
# Reservado — não usado pela estratégia atual do InvestingProvider (ver INVESTING_INCOMING_PATH)
INVESTING_PROFILE_DIR=./storage/session/investing-profile

# Pasta de entrada monitorada: deposite aqui a planilha exportada manualmente
# da Carteira. O InvestingProvider coleta o arquivo mais recente dessa pasta.
INVESTING_INCOMING_PATH=./storage/incoming/investing

# Saída oficial de entrega ao Laboratório 369
OUTPUT_PATH=./storage/output

# Provider de cotações Twelve Data
TWELVE_DATA_API_KEY=
TWELVE_DATA_STAGING_PATH=./storage/downloads/twelvedata

# Limite de créditos/minuto da API Twelve Data (Sprint 17). Também define o
# tamanho do lote de símbolos por requisição. Default seguro: 8 (plano
# gratuito). Só altere se o plano contratado permitir mais créditos/minuto.
TWELVE_DATA_CREDITS_PER_MINUTE=8

# Provider de cotações Yahoo Finance (Sprint 16) — cobre Cobre, WTI e os 11
# Índices que a Twelve Data não oferece em nenhum plano. Sem chave de API
# (endpoint público não documentado oficialmente — ver
# docs/arquitetura/Sprint-16-Provider-YahooFinance.md para a classificação
# institucional desta fonte).
YAHOO_FINANCE_STAGING_PATH=./storage/downloads/yahoofinance

# Provider de cotações Sina Finance (Sprint 16) — Minério de Ferro (I0, DCE),
# decisão do PO. Sem chave de API.
SINA_FINANCE_STAGING_PATH=./storage/downloads/sinafinance

# Transporte do arquivo de output até a produção (Hostinger/investimentos369) - Sprint 14
# Comando oficial: php bin/collector369 transport:production
# Conta FTP restrita ao diretório storage/collector369/output (não tem acesso ao restante do public_html)
PRODUCTION_FTP_HOST=ftp.investimentos369.com
PRODUCTION_FTP_PORT=21
PRODUCTION_FTP_USER=
PRODUCTION_FTP_PASSWORD=
PRODUCTION_FTP_REMOTE_PATH=/
